# Keep this repository focused on application code + core metadata.
# Everything at the top level is ignored by default unless explicitly allowed.
/*

# Core repository files
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.*
!/.editorconfig
!/.gitattributes
!/.github/
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml

# App code and project tooling
!/crates/
!/src-tauri/
!/ui/
!/scripts/

# Preserve intentional placeholders
!**/.gitkeep

# Dependencies / build outputs
**/node_modules/
**/target/
**/dist/
**/dist-ssr/
**/build/
**/release/
**/.vite/
**/.cache/
**/.parcel-cache/
**/*.tsbuildinfo

# Test outputs
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/

# Logs and temp files
**/logs/
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*~
**/*.swp
**/*.swo

# Environment / secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# Databases
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# OS/editor clutter
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/ehthumbs.db
**/ehthumbs_vista.db
**/.idea/
**/.vscode/
**/rust-analyzer.cmd

# Tauri generated files
/src-tauri/gen/schemas/
